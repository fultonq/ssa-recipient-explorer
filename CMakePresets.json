{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Engine + server, debug symbols (CLion / VS Code default)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimised build used for benchmarks and the Docker image",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer/UBSan",
      "description": "Memory and undefined-behaviour checking; run the tests and the server under it",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SSA_SANITIZE": "ON" }
    },
    {
      "name": "engine-only",
      "displayName": "Engine only (no libpq)",
      "description": "For machines without PostgreSQL client headers: engine, tests, benchmark, tools",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SSA_BUILD_SERVER": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "engine-only", "configurePreset": "engine-only" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "engine-only", "configurePreset": "engine-only", "output": { "outputOnFailure": true } }
  ]
}
