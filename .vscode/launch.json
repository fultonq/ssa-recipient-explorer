{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ssa_server (PostgreSQL, compose db)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/server/ssa_server",
      "args": ["--port=8080", "--static=${workspaceFolder}/web/dist"],
      "environment": [
        { "name": "PGHOST", "value": "localhost" },
        { "name": "PGPORT", "value": "5432" },
        { "name": "PGDATABASE", "value": "ssa" },
        { "name": "PGUSER", "value": "ssa" },
        { "name": "PGPASSWORD", "value": "ssa-demo-only" }
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
      "preLaunchTask": "build: debug"
    },
    {
      "name": "ssa_server (no database: generated data)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/server/ssa_server",
      "args": ["--source=generate", "--records=1000000", "--port=8080", "--static=${workspaceFolder}/web/dist"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build: debug"
    },
    {
      "name": "engine unit tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/engine/ssa_tests",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build: debug"
    },
    {
      "name": "server unit tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/server/ssa_server_tests",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build: debug"
    },
    {
      "name": "Python: cross-check backends",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/compare_backends.py",
      "args": ["--queries", "50"],
      "console": "integratedTerminal"
    },
    {
      "name": "Chrome: web UI (vite dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web/src"
    }
  ]
}
