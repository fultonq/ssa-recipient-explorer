# Copy to .env and adjust. Used by compose.yaml. Demo credentials only - this stack holds synthetic data.
POSTGRES_DB=ssa
POSTGRES_USER=ssa
POSTGRES_PASSWORD=ssa-demo-only
PG_PORT=5432
APP_PORT=8080

# Rows to generate on first start (5M takes ~1 min to load + index on a laptop; try 1000000 for a quick start)
SSA_RECORDS=5000000
SSA_SEED=2026

SSA_PG_POOL=4
SSA_THREADS=8
